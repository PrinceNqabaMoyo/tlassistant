<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fundile | CAPS-Grounded Cognitive Engine & LMS • Grades 7–12</title>
  
  <!-- Fonts: Plus Jakarta Sans, Outfit, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              blue: '#13519C',
              'blue-hover': '#0e4180',
              'blue-light': '#2563EB',
              orange: '#FF9100',
              'orange-hover': '#e58200',
              'orange-glow': 'rgba(255, 145, 0, 0.4)',
              navy: '#081326',
              'navy-surface': '#0c1b33',
              'navy-card': '#102242',
              'navy-border': '#1e355b',
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
            display: ['Outfit', '"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          boxShadow: {
            'glow-blue': '0 0 40px -10px rgba(19, 81, 156, 0.5)',
            'glow-orange': '0 0 35px -8px rgba(255, 145, 0, 0.5)',
            'glow-cyan': '0 0 30px -10px rgba(6, 182, 212, 0.4)',
            'antigravity': '0 20px 60px -15px rgba(8, 19, 38, 0.7)',
          },
          animation: {
            'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'float': 'float 6s ease-in-out infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-8px)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Smooth Scroll & Selection */
    ::selection {
      background: rgba(255, 145, 0, 0.25);
      color: #FF9100;
    }
    
    /* Subtle Grid Background for Antigravity aesthetic */
    .bg-grid-pattern {
      background-size: 40px 40px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    }
    
    /* Radial Glow Highlights */
    .radial-hero-glow {
      background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(19, 81, 156, 0.6), rgba(8, 19, 38, 0.98) 70%, #050c18 100%);
    }

    /* Glowing gradient card borders */
    .glowing-card-border {
      position: relative;
    }
    .glowing-card-border::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, rgba(255,255,255,0.15), rgba(19,81,156,0.3), rgba(255,145,0,0.25), transparent);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    /* Ticker Transition */
    .ticker-slot {
      height: 1.15em;
      line-height: 1.15;
      overflow: hidden;
      display: inline-block;
      vertical-align: bottom;
    }
    .ticker-reel {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Custom Hide Scrollbar */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Print styles for A4 test papers */
    @media print {
      body * {
        visibility: hidden;
      }
      #printable-exam-paper, #printable-exam-paper * {
        visibility: visible;
      }
      #printable-exam-paper {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
      }
    }
  </style>
</head>

<body class="bg-[#081326] text-slate-100 font-sans antialiased overflow-x-hidden selection:bg-brand-orange/30 selection:text-white">

  <!-- ═══════════════════════════════════════════════════════════════
       1. FLOATING ANTIGRAVITY COMMAND HEADER
       ═══════════════════════════════════════════════════════════════ -->
  <header class="fixed top-0 inset-x-0 z-50 transition-all duration-300 backdrop-blur-xl bg-[#081326]/85 border-b border-white/10" id="main-header">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-20 gap-3">
        
        <!-- Left: Fundile Logo & National CAPS Badge -->
        <div class="flex items-center gap-3 shrink-0">
          <a href="#hero" class="flex items-center gap-2 group cursor-pointer" aria-label="Fundile Home">
            <!-- Inline SVG Fundile Logo -->
            <svg class="h-8 sm:h-9 w-auto" viewBox="0 0 2200 800" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g transform="translate(23, -76)">
                <g transform="translate(150, 101.77) scale(0.75)">
                  <path fill="#FF9100" d="M281.1 82.4h46.5v55.2h-55v-55.2h8.5z"/>
                  <path fill="#FF9100" d="M234.1 135.1l-27.9 38.8-45.1-32.5 32.1-45 45.5 32-4.6 6.7z"/>
                  <path fill="#FF9100" d="M287.3 233.2l-42.9 32.5-33.4-44.3 44-33.3 32.3 45.1z"/>
                </g>
                <path fill="#FF9100" d="M346.6 323.6l132.2-70.1c11.5-6.1 23.3-11.3 36.8-10.6 11.2.5 21.4 4.6 31 9.7l175.2 93.4c19.4 10.4 38.8 20.9 58.1 31.7 8.9 5 13.7 12.7 13.2 23.3-.2 5.2-2.2 9.2-6.2 11.8l-30.6 18.6-121.9 67.5-91.8 50.9c-8.4 4.5-18.2 7.5-27.6 8.7-10.4 1.3-20.6-2.9-29.8-8l-97.9-50.6-96.8-53.3c-2.9-1.6-5.6-3.6-8.4-5.3-14-8.1-10.5-25.9-1.9-33.2 5.1-4.3 11.1-7.9 17-11.1l89.7-47.8zm163 120.6c2.7-.1 5.8.7 8-1.5l69.4-37.9c4.4-2.4 4.4-4.4-.1-6.9l-68.6-37.4c-3.8-2.1-6.9-2-10.7.1l-67.1 36.8c-1.7.9-3 2.6-4.4 4 1.6 1.3 3 3 4.8 4l68.7 38.8z"/>
                <path fill="#FF9100" d="M530.9 584l144.2-84.8v5.3c.3 25.6 1.3 51.3.8 76.9-.5 22.7-9.5 42.3-27.2 57-8.4 7-17.8 12.8-27 18.7-10.6 6.8-21.6 13-32.4 19.5-15.4 9.3-30.8 18.8-46.3 27.8-17.6 10.2-36 12-54.7 3.3-14.3-6.7-28.3-14.1-42.4-21.2-24.4-12.1-48.9-24-73.2-36.3-23.1-11.7-39.2-29.4-44.8-55.2-1.3-5.8-2.2-11.8-2.3-17.7 0-31 .3-62 .5-93l32.7 18.7 142.4 82c4.7 2.7 10.3 4.9 15.6 5.1 4.5.1 9.2-2.9 14.1-4.7z"/>
                <path fill="#FF9100" d="M727.1 542v37c-.1 3.5.9 5.6 3.7 7.8 14.3 11.2 16.8 30.3 4.7 42.3-4.7 4.6-4.3 8-2.5 13.2 5.1 14.7 9.9 29.5 14.8 44.3 3.9 11.9.3 19.1-11.9 22.5-12.7 3.6-25.6 2.6-38.4.8-5.4-.8-9.6-4.2-12.5-9.1-2.5-4.3-2.3-8.5-.7-12.9 5.7-16.6 11.2-33.2 16.9-49.8 1.1-3 .8-4.8-1.8-7.1-13.2-11.8-12.2-32.1 2.2-43.4 3.1-2.4 4.1-4.9 4.1-8.7-.2-25.8-.2-51.7 0-77.5 0-3 .5-6.3 1.7-9 2.1-4.9 7.8-7.6 12-6.5 4.8 1.3 7.8 5.7 7.8 11.7.1 14.6 0 29.3.1 44.5z"/>
                <text x="850" y="243" dominant-baseline="hanging" font-family="'Outfit', 'Plus Jakarta Sans', sans-serif" fill="#FFFFFF" font-size="475" font-weight="700" letter-spacing="-10">fundile</text>
              </g>
            </svg>
          </a>
          <span class="hidden md:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/5 border border-white/10 text-slate-300">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            CAPS • Grades 7–12
          </span>
        </div>

        <!-- Center: Google Antigravity-Style Translucent Audience Pill Switcher -->
        <nav class="hidden lg:flex items-center p-1 rounded-full bg-slate-900/80 border border-white/10 shadow-inner backdrop-blur-md" id="audience-nav">
          <button 
            type="button" 
            onclick="switchAudience('learners')" 
            id="nav-tab-learners"
            class="audience-nav-btn relative flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer bg-brand-blue text-white shadow-sm ring-1 ring-white/20"
          >
            <i data-lucide="graduation-cap" class="w-3.5 h-3.5 text-amber-300"></i>
            <span>Learners</span>
          </button>
          <button 
            type="button" 
            onclick="switchAudience('parents')" 
            id="nav-tab-parents"
            class="audience-nav-btn relative flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer text-slate-400 hover:text-white hover:bg-white/5"
          >
            <i data-lucide="users" class="w-3.5 h-3.5"></i>
            <span>Parents</span>
          </button>
          <button 
            type="button" 
            onclick="switchAudience('teachers')" 
            id="nav-tab-teachers"
            class="audience-nav-btn relative flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer text-slate-400 hover:text-white hover:bg-white/5"
          >
            <i data-lucide="book-open" class="w-3.5 h-3.5"></i>
            <span>Teachers</span>
          </button>
          <button 
            type="button" 
            onclick="switchAudience('schools')" 
            id="nav-tab-schools"
            class="audience-nav-btn relative flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer text-slate-400 hover:text-white hover:bg-white/5"
          >
            <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
            <span>Schools &amp; HODs</span>
          </button>
        </nav>

        <!-- Right: Actions (Sign In + Free Trial CTA) -->
        <div class="flex items-center gap-3">
          <a 
            href="#pricing" 
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition duration-200 min-h-[44px]"
          >
            Pricing
          </a>
          <button 
            type="button"
            onclick="openTrialModal()" 
            class="relative group inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-brand-orange to-[#f57c00] hover:from-[#f57c00] hover:to-[#e65100] shadow-[0_4px_20px_rgba(255,145,0,0.4)] transition-all duration-300 hover:scale-[1.02] cursor-pointer min-h-[44px]"
          >
            <span>Start Free Trial</span>
            <i data-lucide="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5"></i>
            <span class="absolute -bottom-1 inset-x-4 h-px bg-white/40 blur-[1px]"></span>
          </button>
        </div>

      </div>

      <!-- Mobile Audience Pills Bar (Sticky row for smartphones) -->
      <div class="lg:hidden flex items-center gap-2 py-2 overflow-x-auto no-scrollbar border-t border-white/5">
        <button onclick="switchAudience('learners')" id="mob-tab-learners" class="mob-nav-btn px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-brand-blue text-white">Learners</button>
        <button onclick="switchAudience('parents')" id="mob-tab-parents" class="mob-nav-btn px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap text-slate-300 bg-white/5">Parents</button>
        <button onclick="switchAudience('teachers')" id="mob-tab-teachers" class="mob-nav-btn px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap text-slate-300 bg-white/5">Teachers</button>
        <button onclick="switchAudience('schools')" id="mob-tab-schools" class="mob-nav-btn px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap text-slate-300 bg-white/5">Schools &amp; HODs</button>
      </div>

    </div>
  </header>


  <!-- ═══════════════════════════════════════════════════════════════
       2. HERO SECTION: ANTIGRAVITY COSMIC ATMOSPHERE & SLOT MACHINE
       ═══════════════════════════════════════════════════════════════ -->
  <section id="hero" class="relative pt-32 sm:pt-40 pb-20 sm:pb-32 px-4 sm:px-6 lg:px-8 bg-grid-pattern radial-hero-glow overflow-hidden">
    
    <!-- Ambient Halo Flares -->
    <div class="absolute top-1/4 -left-32 w-96 h-96 rounded-full bg-brand-blue/30 blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/3 -right-20 w-80 h-80 rounded-full bg-brand-orange/20 blur-[140px] pointer-events-none"></div>
    <div class="absolute -bottom-24 left-1/2 -translate-x-1/2 w-[700px] h-72 rounded-full bg-cyan-600/15 blur-[160px] pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto text-center z-10">
      
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-white/5 border border-brand-blue/40 text-blue-200 shadow-glow-blue backdrop-blur-md mb-6 animate-pulse-slow">
        <i data-lucide="sparkles" class="w-4 h-4 text-amber-400"></i>
        <span>South Africa’s Adaptive Cognitive Engine &amp; LMS • Grades 7–12</span>
      </div>

      <!-- Hero Slot Machine Headline -->
      <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.12]">
        <span class="block text-slate-200 font-bold mb-1">Excel in</span>
        
        <!-- Slot machine container -->
        <span class="ticker-slot text-brand-orange font-black" aria-live="polite" id="ticker-container">
          <span class="ticker-reel block text-left" id="ticker-reel" style="transform: translateY(0);">
            <span class="block">Mathematics.</span>
            <span class="block">Physical Sciences.</span>
            <span class="block">Life Sciences.</span>
            <span class="block">Natural Sciences.</span>
            <span class="block">Mathematical Literacy.</span>
            <span class="block">EMS.</span>
            <span class="block">Accounting.</span>
            <span class="block">Business Studies.</span>
            <span class="block text-white bg-gradient-to-r from-brand-orange via-amber-300 to-white bg-clip-text text-transparent">every subject.</span>
          </span>
        </span>

        <span class="block text-2xl sm:text-3xl lg:text-4xl font-semibold mt-3 text-slate-300/90 font-sans tracking-normal">
          Use Fundile, become a top student.
        </span>
      </h1>

      <!-- Value Propositions -->
      <p class="mt-6 text-base sm:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
        Active, step-by-step cognitive scaffolding grounded in the South African CAPS curriculum. No hallucinated shortcuts. No passive copy-pasting. Authentic NSC method marks from day one.
      </p>

      <!-- Key Bullet Points (Glass Pills) -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 max-w-3xl mx-auto text-xs sm:text-sm text-slate-200">
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm">
          <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-orange"></i>
          <span>100% CAPS &amp; NSC Method Marking</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm">
          <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-orange"></i>
          <span>95% Data Cost Savings (1.6 MB vs 450 MB video)</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm">
          <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-orange"></i>
          <span>Zero-LLM Math Ground Truth (0% Hallucinations)</span>
        </div>
      </div>

      <!-- Hero Call-To-Actions -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <button 
          onclick="openTrialModal()" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-brand-orange hover:bg-brand-orange-hover text-white font-bold text-base shadow-[0_12px_40px_rgba(255,145,0,0.35)] transition-all duration-300 hover:scale-[1.02] cursor-pointer min-h-[48px]"
        >
          <span>Start 2-Week Free Trial</span>
          <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </button>

        <a 
          href="#interactive-simulator" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl bg-white/10 hover:bg-white/15 text-white font-semibold text-base border border-white/15 transition-all duration-200 backdrop-blur-md min-h-[48px]"
        >
          <i data-lucide="play" class="w-4 h-4 text-amber-400 fill-amber-400"></i>
          <span>Launch Live Simulator</span>
        </a>
      </div>

      <!-- Trust Assurance Subtitle -->
      <p class="mt-4 text-xs text-slate-400 font-medium">
        ⚡ 2-week full access • No credit card required • Cancel anytime in 1-click
      </p>

    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         OUTCOMES-BASED TRUST BANNER (D2L Brightspace Credibility Metric)
         ═══════════════════════════════════════════════════════════════ -->
    <div class="mt-16 max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 px-4 sm:px-6">
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-white/10 backdrop-blur-md text-center glowing-card-border">
        <div class="text-2xl sm:text-3xl font-extrabold text-white font-display">+1.8 Grade</div>
        <p class="text-xs text-slate-400 mt-1">Average shift in NSC benchmark examinations</p>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-white/10 backdrop-blur-md text-center glowing-card-border">
        <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-display">95.4% Less</div>
        <p class="text-xs text-slate-400 mt-1">Cellular data consumed vs streaming video lectures</p>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-white/10 backdrop-blur-md text-center glowing-card-border">
        <div class="text-2xl sm:text-3xl font-extrabold text-brand-orange font-display">100% Truth</div>
        <p class="text-xs text-slate-400 mt-1">Seeded SymPy &amp; GAAP ledger mathematical integrity</p>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-white/10 backdrop-blur-md text-center glowing-card-border">
        <div class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-display">3 Clicks</div>
        <p class="text-xs text-slate-400 mt-1">To generate printable CAPS test papers &amp; marking memos</p>
      </div>
    </div>

  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       3. INTERACTIVE SIMULATOR COCKPIT: 4 PERSPECTIVES (THE MASTERPIECE)
       ═══════════════════════════════════════════════════════════════ -->
  <section id="interactive-simulator" class="relative py-20 px-4 sm:px-6 lg:px-8 bg-[#0b172e] border-t border-white/10">
    <div class="max-w-6xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-brand-orange bg-brand-orange/10 border border-brand-orange/30 mb-3">
          <i data-lucide="cpu" class="w-3.5 h-3.5"></i>
          <span>Multi-Stakeholder Interactive Simulator</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white tracking-tight">
          Experience Fundile from Every Perspective
        </h2>
        <p class="mt-3 text-base text-slate-300">
          Toggle below to test real workflows: how learners get unstuck without being handed the answer, how parents track true mastery, and how teachers build printable assessments in seconds.
        </p>

        <!-- Perspective Selector Buttons (Cockpit Switcher) -->
        <div class="mt-8 inline-flex p-1.5 rounded-2xl bg-slate-900/90 border border-white/15 shadow-xl max-w-full overflow-x-auto no-scrollbar">
          <button 
            type="button" 
            onclick="switchAudience('learners')" 
            id="sim-tab-learners"
            class="sim-tab-btn flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-brand-blue text-white shadow-md ring-1 ring-white/20"
          >
            <i data-lucide="graduation-cap" class="w-4 h-4 text-amber-300"></i>
            <span>1. Learners</span>
          </button>
          <button 
            type="button" 
            onclick="switchAudience('parents')" 
            id="sim-tab-parents"
            class="sim-tab-btn flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer text-slate-400 hover:text-white hover:bg-white/5"
          >
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>2. Parents</span>
          </button>
          <button 
            type="button" 
            onclick="switchAudience('teachers')" 
            id="sim-tab-teachers"
