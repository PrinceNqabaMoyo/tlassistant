          <div class="p-4 bg-slate-50 border rounded-2xl">
            <span class="text-slate-500 block text-xs">Method Marks Awarded:</span>
            <span class="text-base font-bold text-slate-900">2 of 4 Marks (Consequential Accuracy)</span>
          </div>
          <div class="p-4 bg-slate-50 border rounded-2xl">
            <span class="text-slate-500 block text-xs">Remediation Status:</span>
            <span class="text-base font-bold text-emerald-600">Resolved in 5-min Prerequisite Drill</span>
          </div>
        </div>

        <div class="p-4 bg-blue-50 border border-blue-200 rounded-2xl text-blue-950">
          <strong class="font-bold block mb-1">Recommended Parent Intervention:</strong>
          Ask Nqobile how she decides whether to multiply by 15/115 or 15/100 when a receipt is marked inclusive of VAT.
        </div>
      </div>

      <div class="mt-6 pt-4 border-t flex justify-end gap-3">
        <button onclick="closePdfModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer">
          Close Report
        </button>
        <button onclick="alert('Download simulated: Fundile_Diagnostic_Report_Nqobile_Gr10.pdf (142 KB)')" class="px-4 py-2 rounded-xl text-xs font-bold bg-brand-blue hover:bg-brand-blue-hover text-white flex items-center gap-1.5 cursor-pointer">
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          <span>Download PDF (142 KB)</span>
        </button>
      </div>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════════════════
       13. INTERACTIVE SCRIPTS (SLOT MACHINE, TABS, PRICING, & STATE)
       ═══════════════════════════════════════════════════════════════ -->
  <script>
    // Initialize Lucide icons
    document.addEventListener("DOMContentLoaded", function () {
      if (window.lucide) {
        window.lucide.createIcons();
      }
      initSlotMachine();
      document.getElementById('current-year').innerText = new Date().getFullYear();
    });

    // ── 1. SLOT MACHINE TICKER ──
    const SUBJECTS = [
      'Mathematics.',
      'Physical Sciences.',
      'Life Sciences.',
      'Natural Sciences.',
      'Mathematical Literacy.',
      'EMS.',
      'Accounting.',
      'Business Studies.',
      'every subject.'
    ];
    let currentSlot = 0;
    let slotTimer = null;

    function initSlotMachine() {
      const reel = document.getElementById('ticker-reel');
      if (!reel) return;
      
      slotTimer = setInterval(() => {
        currentSlot++;
        if (currentSlot >= SUBJECTS.length) {
          clearInterval(slotTimer);
          // Restart after 25s
          setTimeout(() => {
            currentSlot = 0;
            reel.style.transform = `translateY(0)`;
            initSlotMachine();
          }, 25000);
          return;
        }
        reel.style.transform = `translateY(-${currentSlot * 1.15}em)`;
      }, 1300);
    }

    // ── 2. AUDIENCE PERSPECTIVE SWITCHER ──
    const perspectives = ['learners', 'parents', 'teachers', 'schools'];

    function switchAudience(selected) {
      // 1. Update Header Tabs
      perspectives.forEach(p => {
        const navBtn = document.getElementById(`nav-tab-${p}`);
        const mobBtn = document.getElementById(`mob-tab-${p}`);
        const simBtn = document.getElementById(`sim-tab-${p}`);
        const panel = document.getElementById(`perspective-${p}`);

        if (p === selected) {
          if (navBtn) {
            navBtn.className = "audience-nav-btn relative flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer bg-brand-blue text-white shadow-sm ring-1 ring-white/20";
          }
          if (mobBtn) {
            mobBtn.className = "mob-nav-btn px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-brand-blue text-white";
          }
          if (simBtn) {
            simBtn.className = "sim-tab-btn flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-brand-blue text-white shadow-md ring-1 ring-white/20";
          }
          if (panel) {
            panel.classList.remove('hidden');
          }
        } else {
          if (navBtn) {
            navBtn.className = "audience-nav-btn relative flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer text-slate-400 hover:text-white hover:bg-white/5";
          }
          if (mobBtn) {
            mobBtn.className = "mob-nav-btn px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap text-slate-300 bg-white/5";
          }
          if (simBtn) {
            simBtn.className = "sim-tab-btn flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer text-slate-400 hover:text-white hover:bg-white/5";
          }
          if (panel) {
            panel.classList.add('hidden');
          }
        }
      });

      if (window.lucide) {
        window.lucide.createIcons();
      }
    }

    // ── 3. LEARNER SIMULATOR INTERACTION ──
    function triggerWorkedCheck() {
      const dialVal = document.getElementById('learner-dial-val');
      if (dialVal) {
        dialVal.innerText = "88% (Level 7 - Exam Ready)";
        dialVal.classList.add('text-brand-orange');
      }
      alert('✓ Internal Consistency Check: All Method & Consequential Accuracy marks confirmed! Mastered Output VAT Calculation.');
    }

    // ── 4. TEACHER VIEW TOGGLE (A4 Paper vs Memo vs Heatmap) ──
    function setTeacherView(mode) {
      const panePaper = document.getElementById('pane-paper');
      const paneMemo = document.getElementById('pane-memo');
      const paneHeatmap = document.getElementById('pane-heatmap');
      const btnPaper = document.getElementById('tview-paper');
      const btnMemo = document.getElementById('tview-memo');
      const btnHeat = document.getElementById('tview-heatmap');

      panePaper.classList.add('hidden');
      paneMemo.classList.add('hidden');
      paneHeatmap.classList.add('hidden');

      btnPaper.className = "flex-1 py-1.5 rounded-lg text-slate-400 hover:text-white text-center cursor-pointer";
      btnMemo.className = "flex-1 py-1.5 rounded-lg text-slate-400 hover:text-white text-center cursor-pointer";
      btnHeat.className = "flex-1 py-1.5 rounded-lg text-slate-400 hover:text-white text-center cursor-pointer";

      if (mode === 'paper') {
        panePaper.classList.remove('hidden');
        btnPaper.className = "flex-1 py-1.5 rounded-lg bg-brand-blue text-white text-center cursor-pointer";
      } else if (mode === 'memo') {
        paneMemo.classList.remove('hidden');
        btnMemo.className = "flex-1 py-1.5 rounded-lg bg-brand-blue text-white text-center cursor-pointer";
      } else if (mode === 'heatmap') {
        paneHeatmap.classList.remove('hidden');
        btnHeat.className = "flex-1 py-1.5 rounded-lg bg-brand-blue text-white text-center cursor-pointer";
      }
    }

    // ── 5. SCHOOL PACING DISPATCH ACTION ──
    function dispatchDrillAction() {
      const btn = document.getElementById('dispatch-btn');
      btn.innerText = "✓ Dispatched to 36 Students";
      btn.classList.remove('bg-cyan-600', 'hover:bg-cyan-500');
      btn.classList.add('bg-emerald-600', 'text-white');
    }

    // ── 6. SGB VOLUME PRICING CALCULATOR ──
    function updateSgbPricing(count) {
      const label = document.getElementById('slider-count-label');
      const discount = document.getElementById('sgb-discount');
      const perLearner = document.getElementById('sgb-per-learner');
      const totalAnnual = document.getElementById('sgb-total-annual');

      label.innerText = `${count} Learners`;

      let rate = 110;
      let discPercent = "25% OFF";

      if (count >= 150 && count < 300) {
        rate = 85;
        discPercent = "45% OFF Retail";
      } else if (count >= 300 && count < 600) {
        rate = 75;
        discPercent = "50% OFF Retail";
      } else if (count >= 600) {
        rate = 65;
        discPercent = "58% OFF Retail";
      }

      const annualTotal = count * rate * 12;
      discount.innerText = discPercent;
      perLearner.innerText = `R${rate} / month`;
      totalAnnual.innerText = `R${annualTotal.toLocaleString()} / yr`;
    }

    // ── 7. PRICING BILLING CYCLE SWITCHER ──
    function setBillingCycle(cycle) {
      const btnMonthly = document.getElementById('bill-monthly');
      const btnAnnual = document.getElementById('bill-annual');
      const priceStandard = document.getElementById('price-standard');
      const cadenceStandard = document.getElementById('cadence-standard');
      const pricePro = document.getElementById('price-pro');
      const cadencePro = document.getElementById('cadence-pro');

      if (cycle === 'annual') {
        btnMonthly.className = "px-4 py-2 rounded-xl text-slate-400 hover:text-white cursor-pointer";
        btnAnnual.className = "px-4 py-2 rounded-xl bg-brand-blue text-white shadow-sm cursor-pointer flex items-center gap-1.5";
        priceStandard.innerText = "R120";
        cadenceStandard.innerText = "/ mo (billed annually)";
        pricePro.innerText = "R239";
        cadencePro.innerText = "/ mo (billed annually)";
      } else {
        btnMonthly.className = "px-4 py-2 rounded-xl bg-brand-blue text-white shadow-sm cursor-pointer";
        btnAnnual.className = "px-4 py-2 rounded-xl text-slate-400 hover:text-white cursor-pointer flex items-center gap-1.5";
        priceStandard.innerText = "R150";
        cadenceStandard.innerText = "/ month";
        pricePro.innerText = "R299";
        cadencePro.innerText = "/ month";
      }
    }

    // ── 8. MODAL TRIGGERS ──
    function openTrialModal(tier = '') {
      const modal = document.getElementById('trial-modal');
      const title = document.getElementById('trial-modal-title');
      if (title && tier) {
        title.innerText = `Start Your 2-Week Free ${tier} Trial`;
      }
      modal.classList.remove('hidden');
    }

    function closeTrialModal() {
      document.getElementById('trial-modal').classList.add('hidden');
    }

    function openDiagnosticPdfModal() {
      document.getElementById('pdf-modal').classList.remove('hidden');
    }

    function closePdfModal() {
      document.getElementById('pdf-modal').classList.add('hidden');
    }

    function handleTrialSubmit(e) {
      e.preventDefault();
      alert('🎉 2-Week Trial Activated! Welcome to Fundile. Check your inbox for your login credentials.');
      closeTrialModal();
    }

    function handleLeadSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('lead-email').value;
      alert(`🎉 Thank you! Free trial instructions dispatched to ${email}.`);
      document.getElementById('lead-capture-form').reset();
    }
  </script>

</body>
</html>
